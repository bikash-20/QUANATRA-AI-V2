# --- Public (exposed to the browser) ---
NEXT_PUBLIC_API_URL=https://your-worker.workers.dev
# Set to 'true' to enable the real Google OAuth flow.
# When 'false' the app falls back to the localStorage DevAuthAdapter.
NEXT_PUBLIC_AUTH_ENABLED=false

# --- Server-only secrets. NEVER prefix these with NEXT_PUBLIC_ ---
# Google OAuth credentials from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where Google sends users after consent. Must be registered in the OAuth
# client and must point at /api/auth/callback on the deployed app.
# Local:   http://localhost:3000/api/auth/callback
# Vercel:  https://quantara-web-sooty.vercel.app/api/auth/callback
AUTH_REDIRECT_URI=

# 32+ random bytes used to sign the session cookie (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# Optional. Comma-separated origins allowed to host the auth flow.
# Defaults to AUTH_REDIRECT_URI's origin if unset.
# AUTH_ALLOWED_ORIGINS=https://quantara-web-sooty.vercel.app,http://localhost:3000

# Optional. Comma-separated emails that should be promoted to admin on sign-in.
# AUTH_ADMIN_EMAILS=you@gmail.com

# Optional. Cookie / role overrides. Defaults shown.
# AUTH_COOKIE_NAME=quantara.session
# AUTH_STATE_COOKIE_NAME=quantara.oauth-state
# SESSION_TTL_SECONDS=604800
# AUTH_DEFAULT_ROLE=user
